{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palonexus.cloud/contracts/developer/exact-action-v3.schema.json",
  "title": "PaloNexus Exact Action V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_profile",
    "tenant_id",
    "agent_id",
    "agent_generation",
    "proxy_id",
    "proxy_generation",
    "proxy_proof_key_thumbprint",
    "run_id",
    "task_id",
    "root_action_id",
    "action_id",
    "grant_id",
    "grant_hash",
    "leaf_delegation_id",
    "pack_id",
    "pack_version",
    "domain_profile_id",
    "domain_profile_version",
    "harness_adapter_id",
    "harness_adapter_version",
    "target_adapter_id",
    "target_adapter_version",
    "policy_version",
    "policy_digest",
    "catalog_version",
    "catalog_digest",
    "action_class",
    "canonical_action",
    "effect",
    "resource",
    "payload",
    "payload_digest",
    "effect_idempotency_key",
    "target_registration_id",
    "target_registration_version",
    "target_mapping_hash",
    "audience",
    "downstream_scope",
    "method",
    "path",
    "approval_reference",
    "approval_version",
    "approved_by",
    "issued_at",
    "action_deadline",
    "expires_at"
  ],
  "properties": {
    "schema_version": {"const": "palonexus.exact-action/v3"},
    "authority_profile": {"const": "palonexus.exact-action/v3"},
    "tenant_id": {"$ref": "#/$defs/nonEmpty"},
    "agent_id": {"$ref": "#/$defs/nonEmpty"},
    "agent_generation": {"type": "integer", "minimum": 1},
    "subagent": {"$ref": "#/$defs/subagent"},
    "proxy_id": {"$ref": "#/$defs/nonEmpty"},
    "proxy_generation": {"type": "integer", "minimum": 1},
    "proxy_proof_key_thumbprint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "run_id": {"$ref": "#/$defs/nonEmpty"},
    "task_id": {"$ref": "#/$defs/nonEmpty"},
    "root_action_id": {"$ref": "#/$defs/nonEmpty"},
    "action_id": {"$ref": "#/$defs/nonEmpty"},
    "grant_id": {"$ref": "#/$defs/nonEmpty"},
    "grant_hash": {"$ref": "#/$defs/sha256"},
    "leaf_delegation_id": {"$ref": "#/$defs/nonEmpty"},
    "pack_id": {"$ref": "#/$defs/nonEmpty"},
    "pack_version": {"$ref": "#/$defs/nonEmpty"},
    "domain_profile_id": {"$ref": "#/$defs/nonEmpty"},
    "domain_profile_version": {"$ref": "#/$defs/nonEmpty"},
    "harness_adapter_id": {"$ref": "#/$defs/nonEmpty"},
    "harness_adapter_version": {"type": "integer", "minimum": 1},
    "target_adapter_id": {"$ref": "#/$defs/nonEmpty"},
    "target_adapter_version": {"type": "integer", "minimum": 1},
    "policy_version": {"$ref": "#/$defs/nonEmpty"},
    "policy_digest": {"$ref": "#/$defs/sha256"},
    "catalog_version": {"type": "integer", "minimum": 1},
    "catalog_digest": {"$ref": "#/$defs/sha256"},
    "action_class": {"$ref": "#/$defs/nonEmpty"},
    "canonical_action": {"$ref": "#/$defs/nonEmpty"},
    "effect": {"$ref": "#/$defs/nonEmpty"},
    "resource": {"$ref": "#/$defs/nonEmpty"},
    "payload": {},
    "payload_digest": {"$ref": "#/$defs/sha256"},
    "effect_idempotency_key": {"$ref": "#/$defs/nonEmpty"},
    "target_registration_id": {"$ref": "#/$defs/nonEmpty"},
    "target_registration_version": {"type": "integer", "minimum": 1},
    "target_mapping_hash": {"$ref": "#/$defs/sha256"},
    "audience": {"$ref": "#/$defs/nonEmpty"},
    "downstream_scope": {"$ref": "#/$defs/nonEmpty"},
    "method": {"type": "string", "pattern": "^[A-Z]+$"},
    "path": {
      "type": "string",
      "maxLength": 2048,
      "$comment": "Root, or one or more non-empty segments of RFC 3986 unreserved characters. Unreserved bytes are the only ones a conforming client never percent-encodes, so the registered target path, the leaf path, and the request line have exactly one spelling.",
      "allOf": [
        {"pattern": "^(?:/|(?:/[A-Za-z0-9._~-]+)+)$"},
        {"not": {"pattern": "(?:^|/)\\.\\.?(?:$|/)"}}
      ]
    },
    "approval_reference": {"$ref": "#/$defs/nonEmpty"},
    "approval_version": {"type": "integer", "minimum": 1},
    "approved_by": {"$ref": "#/$defs/nonEmpty"},
    "issued_at": {"$ref": "#/$defs/canonicalTimestamp"},
    "action_deadline": {"$ref": "#/$defs/canonicalTimestamp"},
    "expires_at": {"$ref": "#/$defs/canonicalTimestamp"}
  },
  "$defs": {
    "subagent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_lease_id",
        "actor_proof_key_thumbprint",
        "child_grant_id",
        "child_grant_hash",
        "parent_agent_id",
        "parent_agent_generation",
        "spawn_request_id",
        "spawn_decision_id",
        "root_agent_id",
        "root_agent_generation",
        "root_run_id",
        "delegation_depth",
        "ancestry_digest"
      ],
      "properties": {
        "identity_lease_id": {"$ref": "#/$defs/nonEmpty"},
        "actor_proof_key_thumbprint": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"},
        "child_grant_id": {"$ref": "#/$defs/nonEmpty"},
        "child_grant_hash": {"$ref": "#/$defs/sha256"},
        "parent_agent_id": {"$ref": "#/$defs/nonEmpty"},
        "parent_agent_generation": {"type": "integer", "minimum": 1},
        "spawn_request_id": {"$ref": "#/$defs/nonEmpty"},
        "spawn_decision_id": {"$ref": "#/$defs/nonEmpty"},
        "root_agent_id": {"$ref": "#/$defs/nonEmpty"},
        "root_agent_generation": {"type": "integer", "minimum": 1},
        "root_run_id": {"$ref": "#/$defs/nonEmpty"},
        "delegation_depth": {"type": "integer", "minimum": 1, "maximum": 32},
        "ancestry_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "$comment": "C0 controls and DEL are refused so one authority identifier cannot be read two ways by a downstream store, log, or C-string consumer.",
      "pattern": "^[^\\x00-\\x1F\\x7F]+$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]*[1-9])?Z$"
    }
  }
}
