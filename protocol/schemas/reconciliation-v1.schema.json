{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.palonexus.dev/protocol/v1/reconciliation-v1.schema.json",
  "title": "PaloNexus reconciliation record version 1",
  "description": "Durable at-least-once delivery state for safe local guard evidence. This contract does not provide distributed exactly-once application effects. This is a draft artifact until the host feasibility gate passes.",
  "type": "object",
  "required": [
    "schemaVersion",
    "reconciliationId",
    "actionId",
    "requestId",
    "correlationId",
    "authorizationIdempotencyKey",
    "clientId",
    "action",
    "targetKind",
    "outcome",
    "reasonCode",
    "observedAt",
    "batchId",
    "batchSequence",
    "deliveryPolicy",
    "attemptCount",
    "deliveryDisposition",
    "state"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/schemaVersion"
    },
    "reconciliationId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^recon_[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Stable identifier reused by every delivery attempt."
    },
    "actionId": {
      "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/actionId"
    },
    "requestId": {
      "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/requestId"
    },
    "decisionId": {
      "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/decisionId"
    },
    "correlationId": {
      "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/correlationId"
    },
    "authorizationIdempotencyKey": {
      "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/idempotencyKey",
      "description": "The stable idempotency key of the authorization attempt that produced this evidence, not an application-effect key."
    },
    "clientId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "allOf": [
        {
          "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/safeText"
        }
      ],
      "description": "Authenticated guard-assigned registered client identity."
    },
    "action": {
      "type": "string",
      "enum": [
        "shell:exec",
        "file:read",
        "file:write",
        "file:delete",
        "web:fetch",
        "mcp:call",
        "tool:invoke"
      ]
    },
    "targetKind": {
      "type": "string",
      "enum": [
        "local-action",
        "mcp-tool",
        "tool"
      ]
    },
    "clientScopeHash": {
      "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/sha256"
    },
    "authoritativeScopeHash": {
      "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/sha256"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "approval_required",
        "error"
      ]
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
      "maxLength": 128,
      "allOf": [
        {
          "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/safeText"
        }
      ]
    },
    "observedAt": {
      "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/timestamp",
      "maxLength": 128
    },
    "batchId": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^batch_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "batchSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "deliveryPolicy": {
      "type": "object",
      "required": [
        "maxAttempts",
        "maxTotalAttempts",
        "baseDelaySeconds",
        "maxDelaySeconds"
      ],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxTotalAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Hard bound including explicit authenticated manual retries; must not be less than maxAttempts."
        },
        "baseDelaySeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "maxDelaySeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "additionalProperties": false
    },
    "attemptCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "lastAttemptAt": {
      "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/timestamp",
      "maxLength": 128
    },
    "nextAttemptAt": {
      "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/timestamp",
      "maxLength": 128,
      "description": "Durably persisted deadline for retry_wait."
    },
    "deliveryDisposition": {
      "type": "string",
      "enum": [
        "automatic",
        "manual_intervention"
      ],
      "description": "Whether the scheduler may consider the record. manual_intervention requires an explicit authenticated retry or discard."
    },
    "manualReasonCode": {
      "type": "string",
      "const": "attempt_limit_reached",
      "description": "Safe closed reason for pausing automatic delivery."
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "sending",
        "retry_wait",
        "acknowledged",
        "discarded"
      ]
    },
    "acknowledgedAt": {
      "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/timestamp",
      "maxLength": 128
    },
    "acknowledgement": {
      "type": "object",
      "required": [
        "receiptId",
        "reconciliationId",
        "evidenceHash",
        "acknowledgedAt"
      ],
      "properties": {
        "receiptId": {
          "type": "string",
          "minLength": 34,
          "maxLength": 34,
          "pattern": "^receipt_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "reconciliationId": {
          "type": "string",
          "minLength": 32,
          "maxLength": 32,
          "pattern": "^recon_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
        },
        "evidenceHash": {
          "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/sha256"
        },
        "acknowledgedAt": {
          "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/timestamp",
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "discardedAt": {
      "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/timestamp",
      "maxLength": 128
    },
    "discard": {
      "type": "object",
      "required": [
        "authorityType",
        "reasonCode"
      ],
      "properties": {
        "authorityType": {
          "type": "string",
          "enum": [
            "authenticated_user",
            "organization_retention_policy"
          ]
        },
        "reasonCode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$",
          "maxLength": 128,
          "allOf": [
            {
              "$ref": "https://schemas.palonexus.dev/protocol/v1/common-v1.schema.json#/$defs/safeText"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "description": "No reconciliation extension keys are registered in protocol version 1.",
      "maxProperties": 0,
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deliveryDisposition": {
            "const": "manual_intervention"
          }
        },
        "required": [
          "deliveryDisposition"
        ]
      },
      "then": {
        "required": [
          "manualReasonCode"
        ]
      },
      "else": {
        "not": {
          "required": [
            "manualReasonCode"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "error"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "reasonCode": {
            "enum": [
              "invalid_request",
              "missing_identity",
              "unsupported_protocol",
              "authentication_failed",
              "authorization_unavailable",
              "invalid_decision",
              "idempotency_conflict",
              "approval_expired",
              "approval_scope_mismatch",
              "credential_revoked",
              "policy_denied"
            ]
          }
        },
        "not": {
          "required": [
            "decisionId"
          ]
        }
      },
      "else": {
        "required": [
          "decisionId",
          "clientScopeHash",
          "authoritativeScopeHash"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "pending"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "nextAttemptAt"
              ]
            },
            {
              "required": [
                "acknowledgedAt"
              ]
            },
            {
              "required": [
                "acknowledgement"
              ]
            },
            {
              "required": [
                "discardedAt"
              ]
            },
            {
              "required": [
                "discard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "sending"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "lastAttemptAt"
        ],
        "properties": {
          "attemptCount": {
            "minimum": 1
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "nextAttemptAt"
              ]
            },
            {
              "required": [
                "acknowledgedAt"
              ]
            },
            {
              "required": [
                "acknowledgement"
              ]
            },
            {
              "required": [
                "discardedAt"
              ]
            },
            {
              "required": [
                "discard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "retry_wait"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "lastAttemptAt",
          "nextAttemptAt"
        ],
        "properties": {
          "attemptCount": {
            "minimum": 1
          },
          "deliveryDisposition": {
            "const": "automatic"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "acknowledgedAt"
              ]
            },
            {
              "required": [
                "acknowledgement"
              ]
            },
            {
              "required": [
                "discardedAt"
              ]
            },
            {
              "required": [
                "discard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "acknowledged"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "lastAttemptAt",
          "acknowledgedAt",
          "acknowledgement"
        ],
        "properties": {
          "attemptCount": {
            "minimum": 1
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "nextAttemptAt"
              ]
            },
            {
              "required": [
                "discardedAt"
              ]
            },
            {
              "required": [
                "discard"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "discarded"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "discardedAt",
          "discard"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "nextAttemptAt"
              ]
            },
            {
              "required": [
                "acknowledgedAt"
              ]
            },
            {
              "required": [
                "acknowledgement"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "enum": [
              "shell:exec",
              "file:read",
              "file:write",
              "file:delete",
              "web:fetch"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "targetKind": {
            "const": "local-action"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "mcp:call"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "targetKind": {
            "const": "mcp-tool"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "tool:invoke"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "targetKind": {
            "const": "tool"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
